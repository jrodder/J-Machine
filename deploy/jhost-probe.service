[Unit]
Description=J-Machine external probe (one ping round trip against the live host)
After=jhost.service
Wants=jhost.service

[Service]
Type=oneshot
User=jrod
WorkingDirectory=/home/jrod/J-Machine
# Deliberately a different process from jhost, not a timer inside it: a check
# that runs inside the thing it checks can only repeat what that thing already
# believes. This one asks the live host for a round trip and records the answer
# in data/probe.json, which is what lets a FAILURE turn the activity page's
# status pill red -- green needs no file, because a successful round trip sends
# the host an ack it counts itself.
ExecStart=/home/jrod/J-Machine/.venv/bin/python -m jhost.probe --data-dir data
# The client gets 10 minutes for the whole check (route discovery and the answer
# share it) plus margin for the ack and interpreter startup, so 1200 here keeps
# the verdict the client's: if systemd kills it first, a check that simply had
# not finished learning routes is recorded as a failure and the page goes red
# over nothing. Raise this together with --budget, not on its own.
TimeoutStartSec=1200
